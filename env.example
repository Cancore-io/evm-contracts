# --- Signing keys -----------------------------------------------------------
# Split by tier so a mainnet owner key is never loaded into routine testnet
# workflows. PRIVATE_KEY is the legacy fallback for both.
# If a key is unset, that tier simply has no signer: read-only tasks still work
# and signing fails with a plain error instead of an invalid-key surprise.
MAINNET_PRIVATE_KEY=your_mainnet_private_key_here
TESTNET_PRIVATE_KEY=your_testnet_private_key_here
PRIVATE_KEY=your_private_key_here

# --- RPC URLs (optional - defaults are provided) -----------------------------
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BNB_RPC_URL=https://bsc-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum.drpc.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- API Keys for contract verification (optional) ---------------------------
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# --- depositUSDCxCanton (scripts/deploy/depositUSDCxCanton.ts) ---------------
# MOVES REAL USDC ON ETHEREUM MAINNET. Irreversible.
#
# Canton party ID of the recipient: <hint>::<fingerprint-hex>.
# It is committed on-chain as keccak256(utf8) with NO checksum — a typo or a
# stale value burns the USDC and mints USDCx to a party that does not exist.
CANTON_RECIPIENT=alice::1220abcdef0123456789abcdef0123456789abcdef0123456789abcdef01234567
# Amount of USDC to deposit. Required — there is deliberately no default.
DEPOSIT_AMOUNT=10
# Max bridge fee in USDC (default 0).
MAX_FEE=0
# Mainnet safety gate: the script refuses to run on chainId 1 without this.
CONFIRM_DEPOSIT=no
