{
  "name": "hardhat-project",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "slither:setup": "./scripts/tools/setup-slither.sh",
    "slither": "./scripts/slither-analysis.sh",
    "fuzz:echidna": "echidna . --contract EchidnaHTLC --config echidna.yaml",
    "security": "npm run slither && npm test",
    "deploy:local": "hardhat run scripts/deploy/deployHTLC.ts",
    "deploy:sepolia": "hardhat run scripts/deploy/deployHTLC.ts --network sepolia",
    "deploy:tokens": "hardhat run scripts/deploy/deployTokens.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.28.4",
    "hardhat-slither": "^1.0.4"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^4.8.0",
    "dotenv": "^17.2.3"
  }
}
