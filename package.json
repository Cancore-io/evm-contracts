{
  "name": "hardhat-project",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "clean": "hardhat clean",
    "gas:generate": "REPORT_GAS=true hardhat test && node scripts/tools/check-gas-drift.mjs --generate",
    "gas:check": "node scripts/tools/check-gas-drift.mjs",
    "verify:smt": "ENABLE_SMT=true hardhat compile",
    "bytecode:generate": "npm run compile && node scripts/tools/check-bytecode-match.mjs --generate",
    "bytecode:check": "npm run compile && node scripts/tools/check-bytecode-match.mjs",
    "slither:setup": "./scripts/tools/setup-slither.sh",
    "slither": "./scripts/slither-analysis.sh",
    "fuzz:echidna": "echidna . --contract EchidnaHTLC --config echidna.yaml",
    "security": "npm run slither && npm run bytecode:check && npm test",
    "deploy:local": "hardhat run scripts/deploy/deployHTLC.ts",
    "deploy:sepolia": "hardhat run scripts/deploy/deployHTLC.ts --network sepolia",
    "deploy:tokens": "hardhat run scripts/deploy/deployTokens.ts",
    "abi:extract": "node scripts/abi/extract-abi.mjs",
    "abi:check": "node scripts/abi/check-abi-drift.mjs",
    "tron:drift": "node scripts/tools/check-tron-drift.mjs",
    "tron:compile": "cd tron && ln -sfn ../node_modules node_modules && tronbox compile",
    "tron:deploy:shasta": "npm run tron:compile && cd tron && tronbox migrate --network shasta",
    "tron:deploy:nile": "npm run tron:compile && cd tron && tronbox migrate --network nile",
    "deposit:usdcx:canton": "hardhat run scripts/deploy/depositUSDCxCanton.ts --network ethereum"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.28.4",
    "hardhat-slither": "^1.0.4",
    "tronbox": "^4.9.0"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^4.8.0",
    "dotenv": "^17.2.3"
  }
}
